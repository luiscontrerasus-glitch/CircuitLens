# Copy to ignored .env.local locally, or configure secrets on the Node host.
PORT=3000
HOST=127.0.0.1
# Enable only after configuring an unbilled Gemini Free Tier project.
LIVE_VISION_ENABLED=false
VISION_PROVIDER=gemini
GEMINI_API_KEY=
# Confirm the key's project has NO linked billing account. This is an operator
# confirmation, not automatic Google billing verification.
GEMINI_FREE_TIER_CONFIRMED=false
# Gemini model is intentionally fixed to gemini-2.5-flash (image understanding).
# OpenAI remains an explicitly selected alternative, outside the $0 launch.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini-2025-04-14
VISION_DAILY_LIMIT=20
# Required for live AI on non-loopback requests. Use a private random value.
VISION_ACCESS_CODE=
# Local request guard: persist where possible; free ephemeral hosts reset it on
# restart. Google's project quota is authoritative; no paid disk is required.
VISION_USAGE_FILE=.runtime/vision-usage.json
